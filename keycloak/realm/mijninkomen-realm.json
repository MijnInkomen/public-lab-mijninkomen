{
  "realm": "mijninkomen",
  "enabled": true,
  "displayName": "MijnInkomen",
  "loginTheme": "mijninkomen",
  "emailTheme": "mijninkomen",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "nl"
  ],
  "defaultLocale": "nl",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "sslRequired": "none",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@mijninkomen.test",
    "fromDisplayName": "MijnInkomen"
  },
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Beheert toegang tot de communityomgeving"
      },
      {
        "name": "communitylid",
        "description": "Heeft toegang tot de communityomgeving"
      }
    ]
  },
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 5,
      "config": {}
    }
  ],
  "clients": [
    {
      "clientId": "oauth2-proxy",
      "name": "MijnInkomen community",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${OAUTH2_PROXY_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:${SITE_PORT}/oauth2/callback",
        "http://localhost:${SITE_PORT}/"
      ],
      "webOrigins": [
        "http://localhost:${SITE_PORT}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:${SITE_PORT}/*"
      },
      "protocolMappers": [
        {
          "name": "rollen in groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "groups",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "toegang-api",
      "name": "Toegang API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${TOEGANG_API_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "${TEST_ADMIN_EMAIL}",
      "email": "${TEST_ADMIN_EMAIL}",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Test",
      "lastName": "Admin",
      "realmRoles": [
        "admin"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "${TEST_LID_EMAIL}",
      "email": "${TEST_LID_EMAIL}",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Test",
      "lastName": "Lid",
      "realmRoles": [
        "communitylid"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_LID_PASSWORD}",
          "temporary": false
        },
        {
          "type": "otp",
          "userLabel": "Testcode",
          "secretData": "{\"value\":\"${TEST_LID_OTP_SECRET}\"}",
          "credentialData": "{\"subType\":\"totp\",\"digits\":6,\"counter\":0,\"period\":30,\"algorithm\":\"HmacSHA1\"}"
        }
      ]
    },
    {
      "username": "service-account-toegang-api",
      "enabled": true,
      "serviceAccountClientId": "toegang-api",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "view-realm"
        ]
      }
    },
    {
      "username": "${TEST_E2E_ADMIN_EMAIL}",
      "email": "${TEST_E2E_ADMIN_EMAIL}",
      "emailVerified": true,
      "enabled": true,
      "firstName": "E2e",
      "lastName": "Admin",
      "realmRoles": [
        "admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_LID_PASSWORD}",
          "temporary": false
        },
        {
          "type": "otp",
          "userLabel": "Testcode",
          "secretData": "{\"value\":\"${TEST_LID_OTP_SECRET}\"}",
          "credentialData": "{\"subType\":\"totp\",\"digits\":6,\"counter\":0,\"period\":30,\"algorithm\":\"HmacSHA1\"}"
        }
      ]
    }
  ]
}
