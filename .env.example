# Kopieer dit bestand naar .env en vul eigen waarden in. Zet .env nooit in Git.

# Poort waarop de website en het inloggen draaien
SITE_PORT=3000

# Kies zelf de wachtwoorden hieronder
KEYCLOAK_ADMIN_USERNAME=beheer
KEYCLOAK_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
TOEGANG_DB_PASSWORD=

# Testaccounts, alleen voor de lokale omgeving
TEST_ADMIN_EMAIL=admin@test.nl
TEST_ADMIN_PASSWORD=
TEST_LID_EMAIL=lid@test.nl
TEST_LID_PASSWORD=
# Admin voor de e2e-test, gebruikt het wachtwoord en de code van TEST_LID
TEST_E2E_ADMIN_EMAIL=e2e-admin@test.nl

# Maak deze vier met: openssl rand -hex 16
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
TOEGANG_API_CLIENT_SECRET=
TEST_LID_OTP_SECRET=
